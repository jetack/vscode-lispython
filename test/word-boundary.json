      "`",
      "~",
      "~@"
    ],
    "tokenPrefixes": [
      "**",
      "*",
      "^",
      ":"
    ],
    "signs": [
      "+",
      "-"
    ],
    "signPeelFollowers": [
      "_",
      "."
    ],
    "neverPeeled": [
      "%=",
      "&=",
      "**=",
      "*=",
      "+=",
      "-=",
      "//=",
      "/=",
      "<<=",
      ">>=",
      "@=",
      "^=",
      "|="
    ],
    "stringPrefix": "\\w*",
    "stringOpenings": [
      "'''",
      "\"\"\"",
      "\""
    ],
    "danglingQuotes": [
      "'",
      "`",
      "~@"
    ],
    "numberToken": "[+-]*(?:(?:(?:\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*|\\d*\\.\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*)[+-])?(?:\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*|\\d*\\.\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*)[jJ]|\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d*\\.\\d+(?:_\\d+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*[eE][\\-\\+]?\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*|\\d+(?:_\\d+)*\\.\\d*|\\d*\\.\\d+(?:_\\d+)*|\\d[\\dA-Za-z]*(?:_[\\dA-Za-z]+)*)",
    "signedComplex": "[+-]*(?:([0-9](?:_?[0-9])*[jJ]|(([0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)([eE][-+]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][-+]?[0-9](?:_?[0-9])*)[jJ])|(([0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)([eE][-+]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][-+]?[0-9](?:_?[0-9])*)|0[xX](?:_?[0-9a-fA-F])+|0[bB](?:_?[01])+|0[oO](?:_?[0-7])+|[0-9](?:_?[0-9])*)[+-](?:([0-9](?:_?[0-9])*[jJ]|(([0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)([eE][-+]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][-+]?[0-9](?:_?[0-9])*)[jJ])|(([0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?|\\.[0-9](?:_?[0-9])*)([eE][-+]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][-+]?[0-9](?:_?[0-9])*)|0[xX](?:_?[0-9a-fA-F])+|0[bB](?:_?[01])+|0[oO](?:_?[0-7])+|[0-9](?:_?[0-9])*)",
    "steps": [
      "run: the stretch of the line around the caret holding no stopChars",
      "lex the line, not the run alone, from the run's start, token after token, until a token reaches or passes the run's end; at each token start try, in this order: an opening token (a wrappers entry + an openings entry); a string opening (stringPrefix + a stringOpenings entry); a dangling quote (a wrappers entry + a danglingQuotes entry, followed by a formEndChars character or the line's end); a meta-indicator (a wrappers entry + a metaChars entry, followed by anything but a formEndChars character or the line's end); a bad prefix (^ + one or more *, then an openings entry, a metaChars entry, or before a stopChars character or the line's end); a number (numberToken, followed by a numberEndChars character or the line's end); else a symbol (the rest of the run). Entries are tried longest first. ~ is a metaChars entry and no danglingQuotes one: a ~ followed by a formEndChars character or the line's end matches none of these patterns, so it is a symbol",
      "the word token: the first token that ends after the caret, or ends at it and is a symbol or number; when there is none, or it is neither a symbol nor a number, the word is empty at the caret",
      "peel the word token's front, repeatedly: never a neverPeeled token; never a number token that does not start with a signs character or that matches signedComplex whole; never a token under 2 characters; else the first tokenPrefixes entry it starts with, after which the rest is a number when it matches numberToken whole and keeps its type otherwise; else a run of signs followed by a str.isalnum character or a signPeelFollowers one, the rest keeping its type; else nothing (the rest is the leaf)",
      "start: the leaf's start, or the token's when the caret is in the peeled front",
      "replaceStart: after the last . between start and the caret",
      "end: the first . after the caret in the token, else its end"
    ]
  },
